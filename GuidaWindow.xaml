<Window
    x:Class="DMInps.GuidaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Guida DMInps"
    Width="700"
    Height="600"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  HEADER  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,20"
            FontSize="22"
            FontWeight="Bold"
            Foreground="#2C3E50"
            Text="Guida Utente DMInps" />

        <!--  CONTENUTO SCROLLABILE  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,15"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  SEZIONE: Requisiti di Sistema  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="#EBF5FB"
                    BorderBrush="#3498DB"
                    BorderThickness="2"
                    CornerRadius="5">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            Text="Requisiti di Sistema" />
                        <TextBlock
                            FontSize="13"
                            Foreground="#34495E"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Il programma funziona estraendo i dati dal database di Millewin." /><LineBreak />
                            <Run Text=" Millewin deve essere installato nel PC" /><LineBreak />
                            <Run Text=" Il servizio PostgreSQL deve essere attivo" /><LineBreak />
                            <Run Text=" Le credenziali del database devono essere configurate correttamente" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  SEZIONE: Passaggi Operativi  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="#D5F4E6"
                    BorderBrush="#27AE60"
                    BorderThickness="2"
                    CornerRadius="5">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            Text="📋 Passaggi per Generare il PDF" />
                        <TextBlock
                            FontSize="13"
                            Foreground="#34495E"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Per creare un certificato INPS seguire questi passaggi:" /><LineBreak /><LineBreak />
                            <Run FontWeight="Bold" Text="1. Selezionare il Medico Certificatore" /><LineBreak />
                            <Run Text="   • Utilizzare il menu a tendina nella sezione 'Medico Certificatore'" /><LineBreak />
                            <Run Text="   • Scegliere il medico titolare che redige la relazione" /><LineBreak />
                            <Run Text="   • I dati del medico vengono caricati automaticamente dal database" /><LineBreak /><LineBreak />
                            <Run FontWeight="Bold" Text="2. Inserire il Codice Fiscale del Paziente" /><LineBreak />
                            <Run Text="   • Digitare o incollare il codice fiscale nell'apposito campo" /><LineBreak />
                            <Run Text="   • Il codice deve essere di 16 caratteri alfanumerici" /><LineBreak />
                            <Run Text="   • Il programma verificherà automaticamente la validità del codice" /><LineBreak /><LineBreak />
                            <Run FontWeight="Bold" Text="3. Aggiungere Note del Medico (opzionale)" /><LineBreak />
                            <Run Text="   • Utilizzare il campo 'Note Aggiuntive del Medico'" /><LineBreak />
                            <Run Text="   • Le note verranno inserite in calce al documento PDF" /><LineBreak />
                            <Run Text="   • Utile per annotazioni personalizzate o osservazioni cliniche" /><LineBreak /><LineBreak />
                            <Run FontWeight="Bold" Text="4. Generare il PDF" /><LineBreak />
                            <Run Text="   • Cliccare sul pulsante 'Genera PDF'" /><LineBreak />
                            <Run Text="   • Il file verrà salvato nella cartella configurata" /><LineBreak />
                            <Run Text="   • Il nome del file seguirà il formato impostato nelle preferenze" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  SEZIONE: Medico Certificatore  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="#E8F8F5"
                    BorderBrush="#16A085"
                    BorderThickness="2"
                    CornerRadius="5">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            Text="Medico Certificatore" />
                        <TextBlock
                            FontSize="13"
                            Foreground="#34495E"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Il medico certificatore deve essere un titolare." /><LineBreak />
                            <Run Text=" Puo' redigere la relazione anche per assistiti di altri colleghi titolari." /><LineBreak />
                            <Run Text="I dati del medico vengono caricati automaticamente dal database." /><LineBreak />
                            <Run Text="E' possibile selezionare dinamicamente il medico dall'elenco." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  SEZIONE: Criteri Selezione Pazienti  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="#FEF9E7"
                    BorderBrush="#F39C12"
                    BorderThickness="2"
                    CornerRadius="5">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            Text="Criteri di Selezione Pazienti" />
                        <TextBlock
                            FontSize="13"
                            Foreground="#34495E"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="I pazienti devono soddisfare i seguenti requisiti:" /><LineBreak />
                            <Run Text="Essere pazienti in convenzione." /><LineBreak />
                            <Run Text="Non essere deceduti." /><LineBreak />
                            <Run Text="Non essere revocati (o con data di revoca fissata nel futuro)." /><LineBreak />
                            <Run Text="Il codice fiscale deve essere valido (16 caratteri)." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  SEZIONE: Terapia Antidiabetica  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="#FCF3CF"
                    BorderBrush="#D4AC0D"
                    BorderThickness="2"
                    CornerRadius="5">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            Text="💊 Criteri di Estrazione Terapia Antidiabetica" />
                        <TextBlock
                            FontSize="13"
                            Foreground="#34495E"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Il programma estrae unicamente i farmaci antidiabetici che:" /><LineBreak />
                            <Run Text="Siano contrassegnati come 'continuativi' in Millewin." /><LineBreak />
                            <Run Text="Appartengano alla categoria ATC 'A10' (farmaci antidiabetici)." /><LineBreak />
                            <Run Text="Vengono organizzati per categoria (Insuline, Secretagoghi, Altri)." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  SEZIONE: Complicanze Diabetiche  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="#FADBD8"
                    BorderBrush="#C0392B"
                    BorderThickness="2"
                    CornerRadius="5">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            Text="⚕ Criteri di Estrazione Complicanze" />
                        <TextBlock
                            FontSize="13"
                            Foreground="#34495E"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Le complicanze del diabete sono estratte secondo:" /><LineBreak />
                            <Run Text="La tabella contenuta nel file 'Complicanze_diabetiche_icd9cm.md'" /><LineBreak />
                            <Run Text="Percorso: AppData\Local\dgzani\DMInps\Docs\" /><LineBreak />
                            <Run Text="La tabella raccoglie patologie indicative di complicanza diabetica" /><LineBreak />
                            <Run Text="Classificazione automatica in: Lieve, Moderata, Grave" /><LineBreak /><LineBreak />
                            <Run FontStyle="Italic" Text="Nota: La tabella puo' essere aggiornata dietro segnalazione all'autore del software che provvedera' a verificare ed eventualmente introdurre le nuove complicanze nei criteri di estrazione dei dati." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  SEZIONE: Note Aggiuntive  -->
                <Border
                    Padding="15"
                    Background="#F4ECF7"
                    BorderBrush="#8E44AD"
                    BorderThickness="2"
                    CornerRadius="5">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            Text="Funzionalita' Aggiuntive" />
                        <TextBlock
                            FontSize="13"
                            Foreground="#34495E"
                            TextWrapping="Wrap">
                            <Run Text=" " /><Run FontWeight="SemiBold" Text="Note del Medico:" /><Run Text=" Campo libero per annotazioni personalizzate" /><LineBreak />
                            <Run Text=" " /><Run FontWeight="SemiBold" Text="Storico Pazienti:" /><Run Text=" Visualizza gli ultimi 10 certificati generati" /><LineBreak />
                            <Run Text=" " /><Run FontWeight="SemiBold" Text="Formato Nome File:" /><Run Text=" Personalizzabile dalle impostazioni" /><LineBreak />
                            <Run Text=" " /><Run FontWeight="SemiBold" Text="Cartella Output:" /><Run Text=" Configurabile tramite menu File" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  PULSANTE CHIUDI  -->
        <Button
            Grid.Row="2"
            Padding="15,8"
            HorizontalAlignment="Right"
            Background="#95A5A6"
            BorderThickness="0"
            Click="BtnChiudi_Click"
            Content="✕ Chiudi"
            FontSize="13"
            FontWeight="Bold"
            Foreground="White" />
    </Grid>
</Window>