<Window
    x:Class="DMInps.InfoProgrammaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Informazioni Programma"
    Width="600"
    Height="550"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  HEADER  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Foreground="#2C3E50"
                Text="DMInps" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="#7F8C8D"
                Text="Sistema di creazione della relazione sul diabete" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="#7F8C8D"
                Text="da allegare al Certificato Introduttivo " />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="#7F8C8D"
                Text="per la domanda di invalidita' civile " />

        </StackPanel>

        <!--  INFORMAZIONI VERSIONE  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,15"
            Padding="15"
            Background="#EBF5FB"
            BorderBrush="#3498DB"
            BorderThickness="2"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,10,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="Versione:" />
                <TextBlock
                    x:Name="TxtVersione"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    FontSize="13"
                    Text="1.0.7" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,10,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="Data:" />
                <TextBlock
                    x:Name="TxtData"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    FontSize="13" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="Autore:" />
                <TextBlock
                    x:Name="TxtAutore"
                    Grid.Row="2"
                    Grid.Column="1"
                    FontSize="13"
                    Text="Dr. Dario Giorgio Zani" />
            </Grid>
        </Border>

        <!--  NOTE VERSIONE CORRENTE  -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,15"
            Padding="15"
            Background="White"
            BorderBrush="#BDC3C7"
            BorderThickness="1"
            CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#2C3E50"
                        Text="Note sulla Versione Corrente" />
                    <TextBlock
                        x:Name="TxtNoteVersione"
                        FontSize="12"
                        Foreground="#34495E"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  PULSANTI  -->
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,10,0"
                Padding="15,8"
                Background="#3498DB"
                BorderThickness="0"
                Click="BtnStorico_Click"
                Content="Storico Versioni"
                FontSize="13"
                FontWeight="Bold"
                Foreground="White" />
            <Button
                Padding="15,8"
                Background="#95A5A6"
                BorderThickness="0"
                Click="BtnChiudi_Click"
                Content="Chiudi"
                FontSize="13"
                FontWeight="Bold"
                Foreground="White" />
        </StackPanel>
    </Grid>
</Window>