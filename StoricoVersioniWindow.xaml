    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Storico Versioni DMInps"
    Width="700"
    Height="600"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  HEADER  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,20"
            FontSize="22"
            FontWeight="Bold"
            Foreground="#2C3E50"
            Text="Storico Versioni" />

