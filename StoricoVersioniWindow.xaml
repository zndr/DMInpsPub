                        </StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="11"
                            Foreground="#7F8C8D"
                            Text="Data rilascio: Dicembre 2024" />
                        <TextBlock
                            FontSize="13"
                            Foreground="#34495E"
                            TextWrapping="Wrap">
