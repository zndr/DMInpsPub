<Window
    x:Class="DMInps.FileNameFormatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Formato Nome File"
    Width="500"
    Height="520"
    MinHeight="450"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,15"
            FontSize="16"
            FontWeight="Bold"
            Text="Configura Formato Nome File" />

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">
            <Border
                Padding="15"
                Background="#F8F9FA"
                BorderBrush="#BDC3C7"
                BorderThickness="1"
                CornerRadius="5">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontWeight="SemiBold"
                        Text="Seleziona gli elementi da includere:" />

                    <CheckBox
                        Margin="0,5"
                        Content="Codice Medico"
                        IsChecked="{Binding IncludiCodiceMedico}"
                        Checked="CheckBox_Changed"
                        Unchecked="CheckBox_Changed" />

                    <CheckBox
                        Margin="0,5"
                        Content="Nome Medico"
                        IsChecked="{Binding IncludiNomeMedico}"
                        Checked="CheckBox_Changed"
                        Unchecked="CheckBox_Changed" />

                    <CheckBox
                        Margin="0,5"
                        Content="Nome Paziente (obbligatorio se CF non selezionato)"
                        IsChecked="{Binding IncludiNomePaziente}"
                        Checked="CheckBox_Changed"
                        Unchecked="CheckBox_Changed" />

                    <CheckBox
                        Margin="0,5"
                        Content="Codice Fiscale (obbligatorio se Nome Paziente non selezionato)"
                        IsChecked="{Binding IncludiCodiceFiscale}"
                        Checked="CheckBox_Changed"
                        Unchecked="CheckBox_Changed" />

                    <CheckBox
                        Margin="0,5"
                        Content="Data e Ora creazione"
                        IsChecked="{Binding IncludiDataOra}"
                        Checked="CheckBox_Changed"
                        Unchecked="CheckBox_Changed" />

                    <TextBlock
                        Margin="0,20,0,5"
                        FontWeight="SemiBold"
                        Text="Separatore:" />

                    <ComboBox
                        x:Name="CmbSeparatore"
                        SelectedValuePath="Tag"
                        SelectedValue="{Binding Separatore}"
                        SelectionChanged="CheckBox_Changed">
                        <ComboBoxItem Content="Underscore (_)" Tag="_" />
                        <ComboBoxItem Content="Trattino (-)" Tag="-" />
                        <ComboBoxItem Content="Punto (.)" Tag="." />
                    </ComboBox>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Margin="0,15"
            Padding="10"
            Background="#ECF0F1"
            BorderBrush="#BDC3C7"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel>
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="Anteprima:" />
                <TextBlock
                    x:Name="TxtPreview"
                    Margin="0,5,0,0"
                    FontFamily="Consolas"
                    FontSize="10"
                    Foreground="#2C3E50"
                    Text="DMInps_esempio.pdf"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="BtnSalva"
                Width="100"
                Margin="0,0,10,0"
                Padding="10,5"
                Background="#27AE60"
                BorderThickness="0"
                Click="BtnSalva_Click"
                Content="Salva"
                FontWeight="Bold"
                Foreground="White" />
            <Button
                x:Name="BtnAnnulla"
                Width="100"
                Padding="10,5"
                Click="BtnAnnulla_Click"
                Content="Annulla" />
        </StackPanel>
    </Grid>
</Window>