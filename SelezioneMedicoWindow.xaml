<Window
    x:Class="DMInps.SelezioneMedicoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Seleziona Medico Certificatore"
    Width="450"
    Height="400"
    WindowStartupLocation="CenterOwner">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,15"
            FontSize="14"
            FontWeight="SemiBold"
            Text="Seleziona il medico certificatore:" />

        <ListBox
            x:Name="ListMedici"
            Grid.Row="1"
            DisplayMemberPath="NomeCompleto"
            MouseDoubleClick="ListMedici_MouseDoubleClick" />

        <StackPanel
            Grid.Row="2"
            Margin="0,15,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="BtnSeleziona"
                Width="100"
                Margin="0,0,10,0"
                Padding="10,5"
                Background="#27AE60"
                BorderThickness="0"
                Click="BtnSeleziona_Click"
                Content="Seleziona"
                FontWeight="Bold"
                Foreground="White" />
            <Button
                x:Name="BtnAnnulla"
                Width="100"
                Padding="10,5"
                Click="BtnAnnulla_Click"
                Content="Annulla" />
        </StackPanel>
    </Grid>
</Window>