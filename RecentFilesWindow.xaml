<Window
    x:Class="DMInps.RecentFilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Certificati Recenti"
    Width="700"
    Height="450"
    WindowStartupLocation="CenterOwner">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,15"
            FontSize="14"
            FontWeight="SemiBold"
            Text="?? Ultimi 10 certificati generati:" />

        <DataGrid
            x:Name="ListFiles"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            MouseDoubleClick="ListFiles_MouseDoubleClick"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Nome}"
                    Header="Nome File" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding Data}"
                    Header="Data Creazione" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding Dimensione}"
                    Header="Dimensione" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel
            Grid.Row="2"
            Margin="0,15,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="BtnApri"
                Width="100"
                Margin="0,0,10,0"
                Padding="10,5"
                Background="#3498DB"
                BorderThickness="0"
                Click="BtnApri_Click"
                Content="Apri"
                FontWeight="Bold"
                Foreground="White" />
            <Button
                x:Name="BtnChiudi"
                Width="100"
                Padding="10,5"
                Click="BtnChiudi_Click"
                Content="Chiudi" />
        </StackPanel>
    </Grid>
</Window>