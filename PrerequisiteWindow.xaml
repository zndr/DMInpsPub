<Window
    x:Class="DMInps.PrerequisiteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Prerequisiti"
    Width="600"
    Height="500"
    WindowStartupLocation="CenterOwner">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            BorderBrush="#BDC3C7"
            BorderThickness="1"
            CornerRadius="5">
            <RichTextBox
                x:Name="TxtContent"
                Padding="15"
                Background="White"
                BorderThickness="0"
                IsReadOnly="True"
                VerticalScrollBarVisibility="Auto" />
        </Border>

        <Button
            x:Name="BtnChiudi"
            Grid.Row="1"
            Width="100"
            Margin="0,15,0,0"
            Padding="10,5"
            HorizontalAlignment="Right"
            Click="BtnChiudi_Click"
            Content="Chiudi" />
    </Grid>
</Window>